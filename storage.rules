rules_version = '2';

// ===========================================================================
// Başak Ödeme & Cari Takip — Firebase Storage Güvenlik Kuralları
//
// Otomatik/manuel yedekler "yedekler/" klasörüne yazılır. Faz 1-3'te kimlik
// anonim (Firebase Anonymous Auth) olduğundan, kimliği doğrulanmış her istemci
// yedek yazıp okuyabilir. Sertleştirme (Faz ileri): Auth custom claims ile
// yalnızca Yönetici'ye izin verilebilir (request.auth.token.rol == 'Yonetici').
//
// `firebase deploy --only storage` ile yayınlanır.
// ===========================================================================

service firebase.storage {
  match /b/{bucket}/o {
    // Yedek dosyaları
    match /yedekler/{dosya} {
      allow read, write: if request.auth != null;
    }
    // Diğer her şey kapalı
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
