# Firebase yapılandırması — Firebase Console > Proje Ayarları > Web Uygulaması'ndan alınır.
# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun. ".env" repoya GİRMEZ.
#
#   cp .env.example .env
#
# Vite kuralı: tarayıcıya açılan değişkenler "VITE_" ön eki ile başlamalıdır.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
