{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Basak Odeme Cari",
  "version": "0.1.0",
  "identifier": "com.punchyazilim.basak",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Basak Odeme & Cari Takip",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "PUNCH YAZILIM",
    "copyright": "© 2026 PUNCH YAZILIM",
    "category": "Business",
    "shortDescription": "Basak Kir Pidesi Odeme & Cari Takip",
    "longDescription": "Basak Kir Pidesi icin tedarikci, taseron, kira ve diger odemeleri firma bazli cari hesap mantigiyla takip eden masaustu uygulamasi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "certificateThumbprint": null,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
